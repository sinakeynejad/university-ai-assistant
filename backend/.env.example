# این فایل را کپی کرده و به نام .env ذخیره کنید

APP_NAME=KNTU RAG Assistant
APP_ENV=development
CORS_ORIGINS=*

UPLOAD_DIR=data/uploads
CHROMA_DIR=data/chroma_db
CHROMA_COLLECTION=kntu_documents

EMBEDDING_MODEL_NAME=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_DEVICE=cpu

# LLM_PROVIDER: mock (بدون کلید، فقط برای تست) یا openai_compatible
LLM_PROVIDER=mock
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL_NAME=gpt-4o-mini
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=800

CHUNK_SIZE=800
CHUNK_OVERLAP=150

TOP_K=4
